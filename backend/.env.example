# Application
APP_NAME=CyberSentinel
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=127.0.0.1
PORT=8000

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Database
# SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./cybersentinel.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cybersentinel

# Rate limiting
RATE_LIMIT_SCANS_PER_MINUTE=10

# Scanner timeouts (seconds)
CONNECT_TIMEOUT=10
READ_TIMEOUT=15
TOTAL_SCAN_TIMEOUT=60

# Response size cap (bytes) — 5 MB
MAX_RESPONSE_BYTES=5242880

# Max redirects allowed during scanning
MAX_REDIRECTS=5
